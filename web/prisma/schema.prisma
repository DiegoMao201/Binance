// This is your Prisma schema file.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Output to the standard location so Next.js picks it up automatically.
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── users ───────────────────────────────────────────────────────────────────
// Mirrors db/schema.sql + changes from migration 002.
// NOTE: The bot's Python allocator also reads/writes this table.
//       NEVER rename or drop columns that the Python layer depends on
//       (balance_usdt, performance_fee_pct, is_active, role).
model User {
  // Primary key — UUID generated by PostgreSQL pgcrypto extension.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email        String  @unique @db.VarChar(320)
  // Nullable: portal uses passwordless OTP, no password is stored.
  passwordHash String? @map("password_hash")
  // display_name is the existing column; mapped to `name` in application code.
  name         String? @map("display_name") @db.VarChar(120)

  // 'admin' | 'client' for portal users; 'investor' kept for legacy rows.
  role String @default("client") @db.VarChar(16)

  // Fee schedule — stored as 0–1 ratios.
  // 0.02 = 2 % entry fee; 0.05 = 5 % performance fee.
  entryFeePct       Decimal @default(0.02) @map("entry_fee_pct")       @db.Decimal(12, 8)
  performanceFeePct Decimal @default(0.05) @map("performance_fee_pct") @db.Decimal(12, 8)

  // Denormalised balance cache (source of truth: pool_ledger).
  balanceUsdt Decimal @default(0) @map("balance_usdt") @db.Decimal(28, 12)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at")      @db.Timestamptz(6)

  otpCodes             OtpCode[]
  ledgerTransactions   LedgerTransaction[]
  userTradeAllocations UserTradeAllocation[]

  @@index([isActive], map: "idx_users_active")
  @@map("users")
}

// ─── otp_codes ────────────────────────────────────────────────────────────────
// Time-bounded, attempt-limited OTP records.
// Plaintext OTP is NEVER persisted — only SHA-256(otp) is stored.
model OtpCode {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

// ─── ledger_transactions ──────────────────────────────────────────────────────
// Immutable audit log: every deposit, fee retention, and withdrawal is recorded.
// NEVER delete rows — financial auditing requires a complete history.
// type: 'DEPOSIT' | 'ENTRY_FEE' | 'PERFORMANCE_FEE' | 'WITHDRAWAL'
model LedgerTransaction {
  id          BigInt   @id @default(autoincrement())
  userId      String   @map("user_id") @db.Uuid

  // Transaction type — constrained at DB level via CHECK (see migration 003).
  type        String   @db.VarChar(32)

  // Broker discriminator — 'binance' | 'deriv' (see migration 005).
  // Defaults to 'binance' for backwards compatibility with existing rows.
  broker      String   @default("binance") @db.VarChar(20)

  // Always positive. The sign is implicit in `type`:
  // DEPOSIT → inflow to client; ENTRY_FEE / PERFORMANCE_FEE → fee retained by admin.
  amountUsdt  Decimal  @map("amount_usdt") @db.Decimal(28, 12)

  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_ledger_user_id")
  @@index([type],   map: "idx_ledger_type")
  @@index([broker], map: "idx_ledger_transactions_broker")
  @@map("ledger_transactions")
}

// ─── user_trade_allocations ──────────────────────────────────────────────────
// Written atomically by the PAMM webhook (app/api/webhooks/trade-closed) on
// every trade close. One row per active client per trade.
//
// PAMM Math per row:
//   gross_pnl  = balance_before × pnl_pct
//   commission = balance_before × fees_pct  (Binance overhead, always ≥ 0)
//   perf_fee   = max(gross_pnl, 0) × performance_fee_pct  (only on wins)
//   admin_fee  = commission + perf_fee
//   net_pnl    = gross_pnl − admin_fee      (credited to client)
//
// NEVER delete rows — financial auditing requires immutable history.
model UserTradeAllocation {
  id             BigInt   @id @default(autoincrement())
  userId         String   @map("user_id")         @db.Uuid

  // Idempotency key: the bot's own opaque trade ID (e.g. Binance orderId or
  // a UUID generated before the close webhook fires). Combined with userId,
  // guarantees exactly-once allocation even on retry/network-error scenarios.
  tradeId        String   @map("trade_id")         @db.VarChar(128)

  symbol         String   @db.VarChar(32)
  side           String   @db.VarChar(8)           // 'BUY' | 'SELL'
  exitReason     String   @default("unknown") @map("exit_reason") @db.VarChar(64)

  // Broker discriminator — 'binance' | 'deriv' (see migration 005).
  // Defaults to 'binance' so historical Binance allocations stay valid.
  broker         String   @default("binance") @db.VarChar(20)

  // All monetary fields use arbitrary-precision Decimal (NUMERIC in Postgres).
  pnlPct         Decimal  @map("pnl_pct")          @db.Decimal(12, 8)
  grossPnlUsdt   Decimal  @map("gross_pnl_usdt")   @db.Decimal(28, 12)
  commissionUsdt Decimal  @default(0) @map("commission_usdt") @db.Decimal(28, 12)
  perfFeeUsdt    Decimal  @default(0) @map("perf_fee_usdt")   @db.Decimal(28, 12)
  adminFeeUsdt   Decimal  @default(0) @map("admin_fee_usdt")  @db.Decimal(28, 12)
  netPnlUsdt     Decimal  @map("net_pnl_usdt")     @db.Decimal(28, 12)

  // Balance snapshots for point-in-time auditability.
  balanceBefore  Decimal  @map("balance_before")   @db.Decimal(28, 12)
  balanceAfter   Decimal  @map("balance_after")    @db.Decimal(28, 12)

  allocatedAt    DateTime @default(now()) @map("allocated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tradeId, userId], name: "unique_trade_per_user", map: "uq_uta_trade_user")
  @@index([userId],      map: "idx_uta_user_id")
  @@index([allocatedAt], map: "idx_uta_allocated_at")
  @@index([symbol],      map: "idx_uta_symbol")
  @@index([broker],      map: "idx_user_trade_allocations_broker")
  @@index([userId, broker], map: "idx_user_trade_allocations_user_broker")
  @@map("user_trade_allocations")
}
