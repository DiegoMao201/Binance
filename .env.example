# Nunca pongas secretos reales en .env.example; usa .env local o variables de Coolify.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Formato esperado si usas proxy autenticado:
# BINANCE_PROXY_URL=http://usuario:password_url_encoded@165.22.89.208:PUERTO
BINANCE_PROXY_URL=
# Opcional: IPs que Binance tiene whitelistadas para esta API key.
BINANCE_WHITELIST_IPS=165.22.89.208
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
