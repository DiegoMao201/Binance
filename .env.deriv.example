# ─── Deriv async daemon — example .env ───────────────────────────────────────
# Copy to .env or merge into Coolify's environment for the deriv container.

# 1) Authentication (REQUIRED).
DERIV_API_TOKEN=
DERIV_APP_ID=1089
DERIV_ACCOUNT_ID=
# UUID of the PAMM beneficiary user (must already exist in PostgreSQL).
DERIV_USER_ID=

# 2) Trading universe.
# Comma-separated synthetic indices: R_10, R_25, R_50, R_75, R_100, etc.
DERIV_SYMBOLS=R_100,R_75,R_50
# true = paper trades only (recommended until token is live-validated)
DERIV_DRY_RUN=true

# 3) Sizing and risk.
DERIV_BANKROLL_USDT=200
DERIV_RISK_PER_TRADE_PCT=0.01
DERIV_MAX_OPEN_CONTRACTS=2
DERIV_MIN_SCORE=7.5
DERIV_MAX_DAILY_DD_PCT=0.02
DERIV_LOSS_STREAK_LOCKOUT=3
DERIV_LOCKOUT_HOURS=12
DERIV_MAX_SPREAD_PCT=0.05

# 4) Contract specs (multiplier contracts on synthetics).
DERIV_CONTRACT_DURATION_SEC=300
DERIV_MULTIPLIER=100
DERIV_TAKE_PROFIT_PCT=0.04
DERIV_STOP_LOSS_PCT=0.02

# 5) Cadence.
DERIV_POLL_SECONDS=5

# 6) PAMM webhook (re-uses the existing Binance webhook).
PAMM_WEBHOOK_URL=https://your-domain/api/webhooks/trade-closed
WEBHOOK_SECRET=

# 7) Telegram (optional — leave blank to disable).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
