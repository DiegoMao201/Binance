FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LOGS_DIR=/data/logs \
    BOT_HEALTH_MAX_AGE_SECONDS=180

WORKDIR /app

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . .

RUN mkdir -p /data/logs

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 CMD ["python", "scripts/bot_healthcheck.py"]

CMD ["python", "main_loop.py"]