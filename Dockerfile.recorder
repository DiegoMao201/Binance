FROM python:3.12-slim

WORKDIR /app

# System deps for asyncpg and pyarrow
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir \
    asyncpg \
    aiohttp \
    pyarrow \
    python-dotenv

# Only copy what the recorder needs — not main_loop.py, not TradeExecutor
COPY services/ ./services/

ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "services.recorder.main"]
